{
  "root": true,
  "project": {
    "name": "sree-krishna"
  },
  "api": {
    "projectId": "ma3ela6t",
    "dataset": "production"
  },
  "plugins": [
    "@sanity/base",
    "@sanity/default-layout",
    "@sanity/default-login",
    "@sanity/desk-tool",
    "@sanity/orderable-document-list",
    "@sanity/dashboard",
    "media",
    "dashboard-widget-netlify"
  ],
  "env": {
    "development": {
      "plugins": ["@sanity/vision"]
    }
