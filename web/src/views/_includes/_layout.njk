{% include '_header.njk' %}

<body class="font-main c-white pen">
  <div id="loader" class="pf inset z9 df fc jcc aic bg-black">
    <span id="loader-percent">0</span>
  </div>
  <noscript id="no-js" class="pf inset z10 df jcc aic bg-black">
    <span>Please enable JS to view this site</span>
  </noscript>

  <div aria-hidden="true" id="sail" class="pf inset z8 df fc jcc aic pen bg-black"></div>
  <div aria-hidden="true" id="scroll-cover" class="pf inset z8 df fc jcc aic pen"></div>

  {% include "_components/_nav.njk" %}

  {# scrolling container #}
  <div id="app" class="z2 pr pen">
    <div data-scroll-content data-hydra-root>
      {{ content | safe }}
    </div>
  </div>

  {% include "_components/_cursor.njk" %}

  <canvas id="gl" class="pf z0 gl pea"></canvas>
  {# <canvas id="twod" class="pf zn2 gl pen"></canvas> #}

  <div id="split" aria-hidden="true">
    <div id="split-text"></div>
    <div id="split-indent"></div>
  </div>
  <div id="grid" class="pf z10 inset df pen" aria-hidden="true"></div>

  {# Use font to force browser to fetch asap #}
  <div id="text-preload" class="pf oh">
    <div class="font-main">q</div>
    <div class="font-alt">q</div>
  </div>

  {# <div id="img-preload" class="pf oh"></div> #}

