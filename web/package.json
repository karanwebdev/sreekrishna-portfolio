{
  "name": "aurum-web",
  "version": "1.1.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf dist rimraf .cache",
    "build": "rimraf dist && run-p builds:* && npm run postcss && cp ./netlify.toml dist",
    "fonts": "node font-gen.js",
    "dev": "run-p devs:*",
    "devs:esbuild": "esbuild src/js/main.js --outdir=dist/js --format=esm --bundle --watch=forever",
    "devs:esbuild-sw": "esbuild src/sw.js --outdir=dist --format=esm --bundle --watch=forever",
    "devs:sassy": "sass --watch --update src/scss/style.scss dist/css/style.css",
    "devs:elee": "eleventy --incremental --watch --serve",
    "builds:esbuild": "esbuild src/js/main.js --outdir=dist/js --format=esm --bundle --minify",
    "builds:esbuild-sw": "esbuild src/sw.js --outdir=dist --format=esm --bundle --minify",
    "builds:elee": "eleventy",
    "builds:sassy": "sass --no-source-map --style=compressed src/scss/style.scss dist/css/style.css",
    "postcss": "postcss dist/css/style.css --replace",
    "debug": "set DEBUG=Eleventy* & eleventy",
    "lint": "eslint ./** --fix"
  },
  "keywords": [],
  "author": "Siddharth",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^1.0.2",
    "@sanity/asset-utils": "^1.3.0",
    "@sanity/block-content-to-markdown": "0.0.5",
    "@sanity/client": "^3.4.1",
    "@sanity/image-url": "^1.0.2",
    "@typescript-eslint/eslint-plugin": "^5.54.1",
    "@typescript-eslint/parser": "^5.54.1",
    "cssnano": "^5.1.15",
    "dotenv": "^16.0.3",
    "esbuild": "^0.17.11",
    "eslint": "^8.35.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.27.5",
    "fontmin": "^0.9.9",
    "get-video-id": "^3.6.5",
    "groq": "^2.33.2",
    "html-minifier": "^4.0.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.21",
    "postcss-cli": "^10.1.0",
    "postcss-combine-media-query": "^1.0.1",
    "postcss-preset-env": "^7.8.3",
    "rimraf": "^3.0.2",
    "sass": "^1.58.3",
    "string": "^3.3.3",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@11ty/eleventy-fetch": "^3.0.0",
    "@justinribeiro/lite-youtube": "^1.5.0",
    "@portabletext/to-html": "^1.0.4",
    "htm": "^3.1.1",
    "ogl": "^0.0.113",
    "vhtml": "^2.2.0"
  },
  "packageManager": "pnpm@10.7.0+sha512.6b865ad4b62a1d9842b61d674a393903b871d9244954f652b8842c2b553c72176b278f64c463e52d40fff8aba385c235c8c9ecf5cc7de4fd78b8bb6d49633ab6"
}
